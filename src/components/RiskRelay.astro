---
import FamilyIcon from './icons/FamilyIcon.astro';
import SparkleIcon from './icons/SparkleIcon.astro';

const steps = [
  {
    n: '01',
    title: 'You take the quiz',
    copy: 'Two minutes, honest answers, one friendly result.',
  },
  {
    n: '02',
    title: 'You pass it on',
    copy: 'Share your link or the QR code with a parent, sibling, or grandparent.',
  },
  {
    n: '03',
    title: 'The relay continues',
    copy: 'Each result becomes a small, low-pressure conversation at home.',
  },
];
---

<section id="relay" class="scroll-mt-24 py-16 sm:py-24">
  <div class="section-wrap">
    <div class="grid items-center gap-12 rounded-[2.5rem] bg-cacao px-6 py-12 text-peony sm:px-10 lg:grid-cols-[1.1fr_0.9fr] lg:px-16">
      <div class="reveal">
        <span class="inline-flex items-center gap-2 rounded-full bg-peony/10 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-leaf">
          <FamilyIcon class="h-3.5 w-3.5" />
          Risk Relay
        </span>
        <h2 class="mt-4 text-3xl font-bold sm:text-4xl">
          Awareness spreads best person to person.
        </h2>
        <p class="mt-4 max-w-md text-peony/75">
          Risk Relay is the peer-to-peer heart of AERIS: every quiz result
          comes with a nudge to pass it on. One share can start a
          conversation an entire family needed.
        </p>

        <ol class="mt-8 space-y-5">
          {steps.map((step) => (
            <li class="flex gap-4">
              <span class="font-display text-2xl font-bold text-leaf">{step.n}</span>
              <div>
                <p class="font-display text-base font-bold">{step.title}</p>
                <p class="mt-1 text-sm text-peony/70">{step.copy}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="reveal reveal-delay-2 mx-auto flex w-full max-w-xs flex-col items-center rounded-[2rem] bg-peony p-7 text-center text-cacao shadow-soft">
        <span class="eyebrow flex items-center gap-1.5">
          <SparkleIcon class="h-3.5 w-3.5 text-grass" />
          Scan to join the relay
        </span>

        <div class="mt-5 flex h-48 w-48 items-center justify-center rounded-3xl bg-white p-3 shadow-card">
          <canvas id="relay-qr" width="176" height="176" class="h-full w-full rounded-xl"></canvas>
        </div>

        <button
          id="copy-relay-link"
          type="button"
          class="pill-btn mt-6 w-full bg-cacao text-peony !py-3 text-sm"
        >
          <span id="copy-relay-link-label">Copy this page's link</span>
        </button>
        <p class="mt-3 text-[11px] text-cacao/50">
          The code points wherever AERIS is currently hosted — perfect for
          printing on flyers or sharing in a group chat.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import QRCode from 'qrcode';

  const canvas = document.getElementById('relay-qr') as HTMLCanvasElement | null;
  const pageUrl = window.location.href;

  if (canvas) {
    QRCode.toCanvas(canvas, pageUrl, {
      width: 176,
      margin: 1,
      color: {
        dark: '#6B403B',
        light: '#FFFFFF',
      },
    }).catch(() => {
      // fail silently — the copy-link button still works as a fallback
    });
  }

  const copyBtn = document.getElementById('copy-relay-link');
  const copyLabel = document.getElementById('copy-relay-link-label');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(pageUrl);
      if (copyLabel) copyLabel.textContent = 'Link copied!';
    } catch {
      if (copyLabel) copyLabel.textContent = pageUrl;
    }
    window.setTimeout(() => {
      if (copyLabel) copyLabel.textContent = "Copy this page's link";
    }, 2200);
  });
</script>
